{%- liquid
  assign t_heading = 'mg.home_menu_board.heading' | t
  if section.settings.heading != blank
    assign t_heading = section.settings.heading
  endif
  assign t_text = 'mg.home_menu_board.text_html' | t
  if section.settings.text != blank
    assign t_text = section.settings.text
  endif
  assign t_button_label = 'mg.home_menu_board.button_label' | t
  if section.settings.button_label != blank
    assign t_button_label = section.settings.button_label
  endif
-%}
{%- comment -%}
  Menu board: products read like a cafe menu. One column per category block,
  each line is the item name, a short description and the price, split by hairline rules.
{%- endcomment -%}
{%- liquid
  # Blocks without a collection use the store collections that have products, in order.
  assign auto_list = ''
  for c in collections limit: 30
    if c.products_count > 0 and c.handle != 'all' and c.handle != 'frontpage'
      assign auto_list = auto_list | append: c.handle | append: ','
    endif
  endfor
  assign auto_handles = auto_list | split: ','
  assign auto_index = 0
-%}
{{ 'home.css' | asset_url | stylesheet_tag }}
<section class="cw-section cw-menu-board color-{{ section.settings.color_scheme }}">
  <div class="cw-wrap">
    <div class="cw-section__head cw-section__head--stack">
      {%- if section.settings.eyebrow != blank -%}<p class="cw-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      {%- if t_heading != blank -%}<h2 class="cw-h2">{{ t_heading | escape }}</h2>{%- endif -%}
      {%- if t_text != blank -%}<div class="cw-rte cw-muted">{{ t_text }}</div>{%- endif -%}
    </div>

    <div class="cw-menu-board__cols" style="--menu-cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
{%- liquid
  assign mg_bk = 'mg.home_menu_board.' | append: block.id | replace: '-', '_'
  assign bt_title = mg_bk | append: '_title' | t
  if bt_title contains 'ranslation missing'
    assign bt_title = ''
  endif
  if block.settings.title != blank
    assign bt_title = block.settings.title
  endif
-%}
        {%- liquid
          assign menu_collection = block.settings.collection
          if menu_collection == blank and auto_handles[auto_index] != blank
            assign menu_collection = collections[auto_handles[auto_index]]
            assign auto_index = auto_index | plus: 1
          endif
          if menu_collection == blank
            assign menu_collection = collections.all
          endif
          assign menu_title = bt_title | default: menu_collection.title
        -%}
        <div class="cw-menu-board__col" {{ block.shopify_attributes }}>
          <h3 class="cw-menu-board__title">
            {%- if menu_collection.url != blank and menu_collection.products_count > 0 -%}
              <a href="{{ menu_collection.url }}">{{ menu_title | escape }}</a>
            {%- else -%}
              {{ menu_title | escape }}
            {%- endif -%}
          </h3>
          <ul class="cw-menu-board__list" role="list">
            {%- if menu_collection.products.size > 0 -%}
              {%- for product in menu_collection.products limit: block.settings.limit -%}
                <li class="cw-menu-board__item">
                  {%- if section.settings.show_thumbnails -%}
                    <span class="cw-menu-board__thumb">
                      {%- if product.featured_media -%}
                        {% render 'image', image: product.featured_media.preview_image, sizes: '64px', max: 160, alt: '' %}
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                  <span class="cw-menu-board__name">
                    <a class="cw-menu-board__link" href="{{ product.url }}">{{ product.title | escape }}</a>
                    {%- if section.settings.show_description and product.description != blank -%}
                      <span class="cw-menu-board__desc">{{ product.description | strip_html | truncatewords: 12 }}</span>
                    {%- endif -%}
                  </span>
                  <span class="cw-menu-board__price">{% render 'price', product: product %}</span>
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..3) -%}
                <li class="cw-menu-board__item">
                  <span class="cw-menu-board__name">{{ 'products.placeholder_title' | t }}</span>
                  <span class="cw-menu-board__price">{{ 450 | times: i | money }}</span>
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

    {%- if t_button_label != blank -%}
      <div class="cw-menu-board__foot">
        <a class="cw-button cw-button--ghost" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ t_button_label | escape }} {% render 'icon', name: 'arrow' %}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:names.menu_board",
  "class": "cw-shopify-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    { "type": "richtext", "id": "text", "label": "t:labels.text" },
    { "type": "range", "id": "columns", "label": "t:labels.columns_desktop", "min": 1, "max": 3, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_description", "label": "t:labels.show_item_description", "default": true },
    { "type": "checkbox", "id": "show_thumbnails", "label": "t:labels.show_thumbnails", "default": false },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label" },
    { "type": "url", "id": "button_link", "label": "t:labels.link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-3" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "t:names.menu_category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "t:labels.collection", "info": "t:info.menu_category" },
        { "type": "text", "id": "title", "label": "t:labels.title_override" },
        { "type": "range", "id": "limit", "label": "t:labels.products_to_show", "min": 2, "max": 10, "step": 1, "default": 5 }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.menu_board",
      "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }]
    }
  ]
}
{% endschema %}
