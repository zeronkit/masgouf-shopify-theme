{%- comment -%}
  Questions on the board: one dark board with the questions and answers written in two columns like a menu,
  each question in bold chalk with its answer under it, separated by chalk rules. No folds. The page content is split
  at its h2 headings: every heading is a question. Topic blocks put chalk words along the top that jump to a question.
{%- endcomment -%}
{%- assign topic_blocks = section.blocks | where: 'type', 'topic' -%}
<section class="cw-section mg-menu-page mg-qa color-{{ section.settings.color_scheme }}">
  <div class="cw-wrap">
    <div class="mg-board mg-qa__board">
      <header class="mg-board__head">
        <h1 class="mg-board__title">{{ page.title | escape }}</h1>
        <p class="mg-board__meta">{{ 'mg.faq.meta' | t }}</p>
      </header>
      {%- if topic_blocks.size > 0 -%}
        <nav class="mg-tabs mg-qa__topics" aria-label="{{ 'mg.faq.topics' | t }}">
          <ul role="list">
            {%- for block in topic_blocks -%}
              {%- liquid
                assign mg_bk = 'mg.faq.' | append: block.id | replace: '-', '_'
                assign bt_label = mg_bk | append: '_label' | t
                if bt_label contains 'ranslation missing'
                  assign bt_label = ''
                endif
                if block.settings.label != blank
                  assign bt_label = block.settings.label
                endif
              -%}
              {%- if bt_label != blank -%}
                <li {{ block.shopify_attributes }}><a class="mg-tab" href="#Q-{{ section.id }}-{{ block.settings.question }}">{{ bt_label | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
      {%- assign parts = page.content | split: '<h2' -%}
      {%- assign intro = '' -%}
      <div class="mg-qa__grid">
        {%- assign q = 0 -%}
        {%- for part in parts -%}
          {%- liquid
            assign chunk = part | strip
            if chunk == blank
              continue
            endif
            unless chunk contains '</h2>'
              assign intro = intro | append: chunk
              continue
            endunless
            assign q = q | plus: 1
            assign head_raw = chunk | split: '</h2>' | first
            assign head_bits = head_raw | split: '>'
            assign question = head_raw | remove_first: head_bits.first | remove_first: '>'
            assign answer = chunk | remove_first: head_raw | remove_first: '</h2>'
          -%}
          <article class="mg-qa__item" id="Q-{{ section.id }}-{{ q }}">
            <h2 class="mg-qa__q">{{ question }}</h2>
            <div class="mg-qa__a cw-rte">{{ answer }}</div>
          </article>
        {%- endfor -%}
      </div>
      {%- if intro != blank -%}<div class="mg-qa__intro cw-rte">{{ intro }}</div>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:names.mg_faq",
  "class": "cw-shopify-section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" },
    { "type": "paragraph", "content": "t:info.mg_faq" }
  ],
  "blocks": [
    {
      "type": "topic",
      "name": "t:names.mg_topic",
      "settings": [
        { "type": "text", "id": "label", "label": "t:labels.mg_fact_label" },
        { "type": "range", "id": "question", "label": "t:labels.mg_topic_question", "min": 1, "max": 30, "step": 1, "default": 1 }
      ]
    }
  ],
  "presets": [{ "name": "t:names.mg_faq" }]
}
{% endschema %}
