{%- liquid
  assign t_products_heading = 'mg.main_404.products_heading' | t
  if section.settings.products_heading != blank
    assign t_products_heading = section.settings.products_heading
  endif
-%}
{%- comment -%}
  404 on the board: the whole page is one board. The missing address is struck through like a sold out line,
  the search field is a chalk line beside Continue shopping, then the shelves as chalk words and eight menu lines.
{%- endcomment -%}
{%- liquid
  assign auto_list = ''
  assign auto_count = 0
  for c in collections limit: 30
    if c.products_count > 0 and c.handle != 'all' and c.handle != 'frontpage' and auto_count < 6
      assign auto_list = auto_list | append: c.handle | append: ','
      assign auto_count = auto_count | plus: 1
    endif
  endfor
  assign auto_handles = auto_list | split: ','
  assign picks = collections.all.products | sort: 'published_at' | reverse
  assign you_may_like = 'search.you_may_like' | t
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'not_found.title' | t
  endif
-%}
<section class="cw-section mg-menu-page mg-lost color-{{ section.settings.color_scheme }}">
  <div class="cw-wrap">
    <div class="mg-board mg-lost__board">
      <header class="mg-board__head">
        <h1 class="mg-board__title">{{ heading | escape }}</h1>
        <p class="mg-board__meta">404</p>
      </header>
      {%- assign sold_out = 'mg.not_found.out' | t -%}
      <ul class="mg-lost__struck" role="list">
        <li>{% render 'mg-text-line', title: request.path, hint: sold_out, struck: true, heading: 'p' %}</li>
        <li>{%- assign l2 = 'mg.not_found.line_2' | t -%}{% render 'mg-text-line', title: l2, hint: sold_out, struck: true, heading: 'p' %}</li>
      </ul>
      <p class="mg-lost__text">{{ 'not_found.text' | t }}</p>
      <div class="mg-lost__find">
        <div class="mg-board__field">{% render 'search-form', id: 'NotFoundSearch', predictive: false %}</div>
        <a class="mg-tab mg-tab--more mg-lost__continue" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }} {% render 'icon', name: 'arrow' %}</a>
      </div>
      {%- if section.settings.show_collections and auto_handles.size > 0 -%}
        <nav class="mg-tabs mg-lost__shelves" aria-labelledby="NotFoundCollections-{{ section.id }}">
          <h2 class="cw-visually-hidden" id="NotFoundCollections-{{ section.id }}">{{ 'not_found.collections' | t }}</h2>
          <ul role="list">
            {%- for handle in auto_handles -%}
              <li><a class="mg-tab" href="{{ collections[handle].url }}">{{ collections[handle].title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
      {%- if section.settings.show_products and picks.size > 0 -%}
        <div class="mg-board__still">
          <h2 class="mg-board__sub">{{ t_products_heading | default: you_may_like | escape }}</h2>
          <ul class="mg-menu" role="list">
            {%- for product in picks limit: 8 -%}
              <li>{% render 'mg-menu-line', product: product, show_desc: false %}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "t:names.not_found",
  "class": "cw-shopify-section",
  "enabled_on": { "templates": ["404"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    { "type": "checkbox", "id": "show_collections", "label": "t:labels.show_collections", "default": true },
    { "type": "checkbox", "id": "show_products", "label": "t:labels.show_products", "default": true },
    { "type": "text", "id": "products_heading", "label": "t:labels.products_heading" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
