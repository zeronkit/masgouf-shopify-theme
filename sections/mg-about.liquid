{%- comment -%}
  A day at the stall: the page title on a chalk board strip, then zig-zag rows that pair a round plate photo with one part of
  the story, alternating sides. Rows come from Story blocks (image, heading, text); without them the page content is split at
  its h2 headings and the Photo blocks (or collection photos) fill the plates. Fact blocks close the page as menu lines.
{%- endcomment -%}
{%- liquid
  assign story_blocks = section.blocks | where: 'type', 'story'
  assign photo_blocks = section.blocks | where: 'type', 'photo'
  assign fact_blocks = section.blocks | where: 'type', 'fact'
  assign fallback_images = ''
  for c in collections limit: 12
    if c.featured_image
      assign fallback_images = fallback_images | append: c.handle | append: ','
    endif
  endfor
  assign fallback_handles = fallback_images | split: ','
-%}
<section class="cw-section mg-day color-{{ section.settings.color_scheme }}">
  <div class="cw-wrap">
    <header class="mg-board mg-day__strip">
      <h1 class="mg-day__title">{{ page.title | escape }}</h1>
      {%- assign t_kicker = 'mg.about.kicker' | t -%}
      {%- if section.settings.kicker != blank -%}{%- assign t_kicker = section.settings.kicker -%}{%- endif -%}
      {%- if t_kicker != blank -%}<p class="mg-day__kicker">{{ t_kicker | escape }}</p>{%- endif -%}
    </header>

    <ol class="mg-day__rows" role="list">
      {%- if story_blocks.size > 0 -%}
        {%- for block in story_blocks -%}
          <li class="mg-day__row" {{ block.shopify_attributes }}>
            <div class="mg-day__plate">
              {%- if block.settings.image != blank -%}
                {% render 'image', image: block.settings.image, sizes: '(min-width: 750px) 320px, 70vw', max: 800 %}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'cw-placeholder' }}
              {%- endif -%}
            </div>
            <div class="mg-day__text cw-rte">
              {%- if block.settings.heading != blank -%}<h2>{{ block.settings.heading | escape }}</h2>{%- endif -%}
              {{ block.settings.text }}
            </div>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- assign parts = page.content | split: '<h2' -%}
        {%- assign row = 0 -%}
        {%- for part in parts -%}
          {%- liquid
            assign chunk = part | strip
            if chunk == blank
              continue
            endif
            if forloop.first and page.content contains '<h2'
              assign first_is_heading = false
              assign starts = page.content | strip | slice: 0, 3
              if starts == '<h2'
                assign first_is_heading = true
              endif
            endif
            if forloop.first and first_is_heading != true
              assign body = chunk
            else
              assign body = '<h2' | append: chunk
            endif
            assign photo = nil
            if photo_blocks[row] != blank
              assign photo = photo_blocks[row].settings.image
            else
              assign fb_index = row
              assign fb_handle = fallback_handles[fb_index]
              if fb_handle != blank
                assign photo = collections[fb_handle].featured_image
              endif
            endif
            assign row = row | plus: 1
          -%}
          <li class="mg-day__row">
            <div class="mg-day__plate">
              {%- if photo != blank -%}
                {% render 'image', image: photo, sizes: '(min-width: 750px) 320px, 70vw', max: 800 %}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'cw-placeholder' }}
              {%- endif -%}
            </div>
            <div class="mg-day__text cw-rte">{{ body }}</div>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ol>

    {%- if fact_blocks.size > 0 -%}
      <div class="mg-day__facts">
        <h2 class="mg-day__facts-title">{{ 'mg.about.facts' | t }}</h2>
        <dl class="mg-day__lines">
          {%- for block in fact_blocks -%}
            {%- liquid
              assign mg_bk = 'mg.about.' | append: block.id | replace: '-', '_'
              assign bt_label = mg_bk | append: '_label' | t
              if bt_label contains 'ranslation missing'
                assign bt_label = ''
              endif
              if block.settings.label != blank
                assign bt_label = block.settings.label
              endif
              assign bt_value = mg_bk | append: '_value' | t
              if bt_value contains 'ranslation missing'
                assign bt_value = ''
              endif
              if block.settings.value != blank
                assign bt_value = block.settings.value
              endif
            -%}
            <div class="mg-day__line" {{ block.shopify_attributes }}><dt>{{ bt_label | escape }}</dt><dd>{{ bt_value | escape }}</dd></div>
          {%- endfor -%}
        </dl>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:names.mg_about",
  "class": "cw-shopify-section",
  "enabled_on": { "templates": ["page"] },
  "settings": [
    { "type": "text", "id": "kicker", "label": "t:labels.eyebrow" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" },
    { "type": "paragraph", "content": "t:info.mg_about" }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "t:names.mg_story",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:labels.image" },
        { "type": "text", "id": "heading", "label": "t:labels.heading" },
        { "type": "richtext", "id": "text", "label": "t:labels.text" }
      ]
    },
    {
      "type": "photo",
      "name": "t:names.mg_photo",
      "settings": [{ "type": "image_picker", "id": "image", "label": "t:labels.image" }]
    },
    {
      "type": "fact",
      "name": "t:names.mg_fact",
      "settings": [
        { "type": "text", "id": "label", "label": "t:labels.mg_fact_label" },
        { "type": "text", "id": "value", "label": "t:labels.mg_fact_value" }
      ]
    }
  ],
  "presets": [{ "name": "t:names.mg_about" }]
}
{% endschema %}
