{%- comment -%} Masgouf theme by ZeronKit (https://zeronkit.com). Free theme - not for resale or redistribution. © 2026 ZeronKit. {%- endcomment -%}
{%- liquid
  assign t_heading = 'mg.collection_list.heading' | t
  if section.settings.heading != blank
    assign t_heading = section.settings.heading
  endif
-%}
{%- liquid
  # Blocks without a collection use the store collections that have products, in order.
  assign auto_list = ''
  for c in collections limit: 30
    if c.products_count > 0 and c.handle != 'all' and c.handle != 'frontpage'
      assign auto_list = auto_list | append: c.handle | append: ','
    endif
  endfor
  assign auto_handles = auto_list | split: ','
  assign auto_index = 0
-%}
{%- if section.settings.shape == 'awning' -%}
  {%- comment -%}
    The awning: one wide photo of the stall with the striped awning edge along its top, and the categories as paper tabs
    hanging from it, each with its name and product count. On phones the tabs become a sideways row above the photo.
  {%- endcomment -%}
  {%- liquid
    assign stall_image = section.settings.image
    if stall_image == blank
      for block in section.blocks
        if block.settings.collection.featured_image
          assign stall_image = block.settings.collection.featured_image
          break
        endif
      endfor
    endif
  -%}
  <section class="cw-section mg-awnlist color-{{ section.settings.color_scheme }}">
    <div class="cw-wrap">
      {%- if t_heading != blank or section.settings.eyebrow != blank -%}
        <div class="cw-section__head">
          <div>
            {%- if section.settings.eyebrow != blank -%}<p class="cw-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
            {%- if t_heading != blank -%}<h2 class="cw-h2" id="Aisles-{{ section.id }}">{{ t_heading | escape }}</h2>{%- endif -%}
          </div>
        </div>
      {%- endif -%}
      <div class="mg-awnlist__stall">
        <div class="mg-awnlist__awning" aria-hidden="true"></div>
        <ul class="mg-awnlist__tabs" role="list"{% if t_heading != blank %} aria-labelledby="Aisles-{{ section.id }}"{% endif %}>
          {%- for block in section.blocks -%}
            {%- liquid
              assign card_collection = block.settings.collection
              if card_collection == blank and auto_handles[auto_index] != blank
                assign card_collection = collections[auto_handles[auto_index]]
                assign auto_index = auto_index | plus: 1
              endif
            -%}
            <li {{ block.shopify_attributes }}>
              {%- if card_collection != blank -%}
                <a class="mg-hangtab" href="{{ card_collection.url }}">
                  <span class="mg-hangtab__name">{{ card_collection.title | escape }}</span>
                  <span class="mg-hangtab__count">{{ 'mg.board.items' | t: count: card_collection.products_count }}</span>
                </a>
              {%- else -%}
                <span class="mg-hangtab"><span class="mg-hangtab__name">{{ 'collections.placeholder_title' | t }}</span></span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        <div class="mg-awnlist__photo">
          {%- if stall_image != blank -%}
            {% render 'image', image: stall_image, sizes: '(min-width: 1300px) 1220px, 100vw', max: 2400, alt: '' %}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'cw-placeholder' }}
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- else -%}
{{ 'home.css' | asset_url | stylesheet_tag }}
<section class="cw-section cw-collection-list--{{ section.settings.shape }} color-{{ section.settings.color_scheme }}">
  <div class="cw-wrap">
    {%- if t_heading != blank or section.settings.eyebrow != blank -%}
      <div class="cw-section__head">
        <div>
          {%- if section.settings.eyebrow != blank -%}<p class="cw-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          {%- if t_heading != blank -%}<h2 class="cw-h2">{{ t_heading | escape }}</h2>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
    <ul class="cw-grid cw-grid--{{ section.settings.columns }} cw-grid--m2" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_collection = block.settings.collection
          if card_collection == blank and auto_handles[auto_index] != blank
            assign card_collection = collections[auto_handles[auto_index]]
            assign auto_index = auto_index | plus: 1
          endif
        -%}
        <li {{ block.shopify_attributes }}>{% render 'collection-card', collection: card_collection, placeholder_index: forloop.index0 %}</li>
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "t:names.collection_list",
  "class": "cw-shopify-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    {
      "type": "select",
      "id": "shape",
      "label": "t:labels.card_shape",
      "options": [
        { "value": "plates", "label": "t:options.round_plates" },
        { "value": "cards", "label": "t:options.cards" },
        { "value": "awning", "label": "t:options.mg_awning" }
      ],
      "default": "plates"
    },
    { "type": "range", "id": "columns", "label": "t:labels.columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "image_picker", "id": "image", "label": "t:labels.mg_stall_photo", "info": "t:info.mg_stall_photo" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:names.collection",
      "settings": [{ "type": "collection", "id": "collection", "label": "t:labels.collection" }]
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_list",
      "blocks": [{ "type": "collection" }, { "type": "collection" }, { "type": "collection" }, { "type": "collection" }]
    }
  ]
}
{% endschema %}
