{%- liquid
  assign t_ticket_note = 'mg.main_cart.ticket_note_html' | t
  if section.settings.ticket_note != blank
    assign t_ticket_note = section.settings.ticket_note
  endif
  assign t_suggestions_heading = 'mg.main_cart.suggestions_heading' | t
  if section.settings.suggestions_heading != blank
    assign t_suggestions_heading = section.settings.suggestions_heading
  endif
-%}
{%- comment -%}
  Cart page as the counter: a dark board on top holds the order (the total in large chalk figures with the delivery meter,
  the gift note, Checkout); the lines follow as a two column list of round plates. An empty cart offers fresh products.
{%- endcomment -%}
{%- liquid
  assign form_id = 'CartForm-' | append: section.id
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'cart.title' | t
  endif
-%}
<section class="cw-section mg-counterpage color-{{ section.settings.color_scheme }}">
  <cw-cart class="cw-wrap cw-cart" data-section-id="{{ section.id }}">
    <div data-cw-cart-content data-count="{{ cart.item_count }}" data-count-label="{{ 'cart.title_with_count' | t: count: cart.item_count }}" data-total="{{ cart.total_price | money | escape }}">
      {%- if cart.item_count > 0 -%}
        <div class="mg-board mg-countboard">
          <div class="mg-countboard__sum">
            <h1 class="mg-countboard__title">{{ 'mg.cart.your_order' | t: count: cart.item_count }}</h1>
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <ul class="mg-countboard__discounts" role="list">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li class="cw-discount"><span>{{ discount.title | escape }}</span> <span>-{{ discount.total_allocated_amount | money }}</span></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
            <p class="mg-countboard__total"><span class="mg-countboard__label">{{ 'cart.subtotal' | t }}</span> <span class="mg-countboard__figure">{{ cart.total_price | money_with_currency }}</span></p>
            <p class="mg-countboard__tax">
              {%- if cart.duties_included and cart.taxes_included -%}
                {{ 'cart.duties_taxes_included' | t }}
              {%- elsif cart.taxes_included -%}
                {{ 'cart.taxes_included' | t }}
              {%- else -%}
                {{ 'cart.taxes_at_checkout' | t }}
              {%- endif -%}
            </p>
            {% render 'mg-free-delivery', context: 'page' %}
          </div>
          {%- if settings.cart_note -%}
            <details class="mg-note mg-note--fold mg-countboard__note" open>
              <summary class="mg-note__label">{{ 'cart.note_label' | t }}{% render 'icon', name: 'plus' %}</summary>
              <p class="mg-note__hint" id="{{ form_id }}-note-hint">{{ 'cart.note_hint' | t }}</p>
              <label class="cw-visually-hidden" for="{{ form_id }}-note">{{ 'cart.note_label' | t }}</label>
              <textarea class="cw-input mg-note__field" id="{{ form_id }}-note" name="note" form="{{ form_id }}" rows="4" maxlength="500" aria-describedby="{{ form_id }}-note-hint" data-cw-note>{{ cart.note }}</textarea>
            </details>
          {%- endif -%}
          <div class="mg-countboard__go cw-summary">
            <button type="submit" name="checkout" form="{{ form_id }}" class="cw-button cw-button--primary cw-button--full">{{ 'cart.checkout' | t }}</button>
            {%- if additional_checkout_buttons -%}
              <div class="cw-summary__extra">{{ content_for_additional_checkout_buttons }}</div>
            {%- endif -%}
            {%- if t_ticket_note != blank -%}
              <div class="cw-rte mg-countboard__ticket">{{ t_ticket_note }}</div>
            {%- endif -%}
          </div>
        </div>
        <form action="{{ routes.cart_url }}" method="post" id="{{ form_id }}" class="mg-counterpage__lines" novalidate>
          <h2 class="cw-visually-hidden">{{ 'cart.title_with_count' | t: count: cart.item_count }}</h2>
          {% render 'cart-lines', section_id: section.id, style: 'plates' %}
          <noscript><button type="submit" class="cw-button cw-button--ghost" name="update">{{ 'cart.update' | t }}</button></noscript>
        </form>
        <a class="mg-counterpage__more" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }} {% render 'icon', name: 'arrow' %}</a>
      {%- else -%}
        <div class="mg-board mg-countboard mg-countboard--empty">
          <h1 class="mg-countboard__title">{{ heading | escape }}</h1>
          <p class="mg-countboard__figure">{{ 'cart.empty' | t }}</p>
          <p>{{ 'cart.empty_hint' | t }}</p>
          <a class="cw-button cw-button--primary" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
          {%- if section.settings.show_suggestions -%}
            {%- assign picks = section.settings.suggestions_collection.products -%}
            {%- if picks.size == 0 -%}{%- assign picks = collections.all.products -%}{%- endif -%}
            {%- if picks.size > 0 -%}
              <div class="mg-board__still">
                <h2 class="mg-board__sub">{{ t_suggestions_heading | escape }}</h2>
                <ul class="mg-menu" role="list">
                  {%- for product in picks limit: 6 -%}
                    <li>{% render 'mg-menu-line', product: product, show_desc: false %}</li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </cw-cart>
</section>

{% schema %}
{
  "name": "t:names.cart",
  "class": "cw-shopify-section",
  "enabled_on": { "templates": ["cart"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "t:labels.heading", "info": "t:info.cart_heading" },
    { "type": "richtext", "id": "ticket_note", "label": "t:labels.ticket_note" },
    { "type": "header", "content": "t:labels.empty_cart" },
    { "type": "checkbox", "id": "show_suggestions", "label": "t:labels.show_suggestions", "default": true },
    { "type": "text", "id": "suggestions_heading", "label": "t:labels.heading" },
    { "type": "collection", "id": "suggestions_collection", "label": "t:labels.collection", "info": "t:info.suggestions_collection" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ]
}
{% endschema %}
