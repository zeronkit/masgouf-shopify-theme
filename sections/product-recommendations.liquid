{%- liquid
  assign t_heading = 'mg.product_recommendations.heading' | t
  if section.settings.heading != blank
    assign t_heading = section.settings.heading
  endif
-%}
{%- comment -%}
  "More from the counter": Shopify's related products, loaded after the page.
  When Shopify has no recommendations, the product's first collection (or the newest products) fills the row.
{%- endcomment -%}
{{ 'product.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign is_rail = false
  if section.settings.layout == 'rail'
    assign is_rail = true
  endif
  assign list = blank
  if recommendations.performed
    if recommendations.products_count > 0
      assign list = recommendations.products
    elsif product.collections.first.products_count > 1
      assign list = product.collections.first.products
    else
      assign list = collections.all.products
    endif
  endif
-%}
<section class="cw-section cw-related color-{{ section.settings.color_scheme }}">
  <cw-recommendations
    class="cw-wrap"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}&intent=related"
  >
    {%- if list != blank -%}
      <cw-slider class="cw-slider cw-related__board">
        <div class="cw-section__head cw-related__head">
          <div>
            {%- if section.settings.eyebrow != blank -%}<p class="cw-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
            {%- if t_heading != blank -%}<h2 class="cw-h2">{{ t_heading | escape }}</h2>{%- endif -%}
          </div>
          {%- if is_rail -%}
            <div class="cw-section__actions">{% render 'slider-controls', label: t_heading %}</div>
          {%- endif -%}
        </div>
        <ul class="cw-grid cw-grid--{{ section.settings.columns }} cw-grid--m2{% if is_rail %} cw-grid--rail{% endif %}" role="list"{% if is_rail %} data-cw-slider-track{% endif %}>
          {%- assign shown = 0 -%}
          {%- for rec in list -%}
            {%- if rec.id == product.id -%}{%- continue -%}{%- endif -%}
            {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            <li>{% render 'product-card', product: rec %}</li>
          {%- endfor -%}
        </ul>
        {%- if is_rail -%}
          <span class="cw-slider__progress" data-cw-slider-progress hidden aria-hidden="true"><span></span></span>
        {%- endif -%}
      </cw-slider>
    {%- endif -%}
  </cw-recommendations>
</section>

{% schema %}
{
  "name": "t:names.related_products",
  "class": "cw-shopify-section",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "t:info.related_food" },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        { "value": "grid", "label": "t:options.grid" },
        { "value": "rail", "label": "t:options.scroll_rail" }
      ],
      "default": "rail"
    },
    { "type": "range", "id": "limit", "label": "t:labels.products_to_show", "min": 2, "max": 10, "step": 1, "default": 6 },
    { "type": "range", "id": "columns", "label": "t:labels.columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-3" }
  ],
  "presets": [{ "name": "t:names.related_products" }]
}
{% endschema %}
