{%- liquid
  assign t_eyebrow = 'mg.featured_product.eyebrow' | t
  if section.settings.eyebrow != blank
    assign t_eyebrow = section.settings.eyebrow
  endif
-%}
{%- liquid
  assign product = section.settings.product
  if product == blank
    for candidate in collections.all.products limit: 20
      if candidate.available
        assign product = candidate
        break
      endif
    endfor
  endif
  assign variant = product.selected_or_first_available_variant
-%}
{%- comment -%}
  Today's special: one centred chalk card. A small round photo sits at its top start corner; the name in chalk script,
  the price on a paper tag, two lines of text, the sizes as menu lines with their prices, quantity and Add to cart.
{%- endcomment -%}
<section class="cw-section cw-featured-product mg-special-section color-{{ section.settings.color_scheme }}">
  {%- if product != blank -%}
    <cw-product class="cw-wrap" data-section-id="{{ section.id }}" data-url="{{ product.url }}">
      <div class="mg-board mg-special">
        {%- if product.featured_media -%}
          <div class="mg-special__plate">
            {% render 'image', image: product.featured_media.preview_image, sizes: '(min-width: 750px) 190px, 140px', max: 500, class: 'mg-special__img' %}
          </div>
        {%- endif -%}
        <div class="mg-special__top">
          {%- if t_eyebrow != blank -%}<p class="mg-special__eyebrow">{{ t_eyebrow | escape }}</p>{%- endif -%}
          <h2 class="mg-special__name">{{ product.title | escape }}</h2>
          <div class="mg-special__tag" data-cw-swap="price-featured">{% render 'price', product: product, variant: variant, badge: true %}</div>
        </div>
        {%- assign special_text = product.description | strip_html | strip_newlines | truncate: 170 -%}
        {%- if special_text != blank -%}<p class="mg-special__text">{{ special_text | escape }}</p>{%- endif -%}
        <div class="mg-special__picker" data-cw-swap="picker-featured" data-variant-id="{{ variant.id }}" data-variant-media="{{ variant.featured_media.id }}">
          {% render 'variant-picker', product: product, section_id: section.id, style: 'menu' %}
        </div>
        <div class="mg-special__buy" data-cw-swap="buy-featured">
          {% render 'buy-form', product: product, variant: variant, section_id: section.id, show_checkout: section.settings.show_dynamic_checkout, show_pickup: false, show_quantity: true %}
        </div>
        <a class="mg-special__more" href="{{ product.url }}">{{ 'products.view_details' | t }}<span class="cw-visually-hidden">: {{ product.title | escape }}</span> {% render 'icon', name: 'arrow' %}</a>
      </div>
    </cw-product>
  {%- else -%}
    <div class="cw-wrap">
      <div class="mg-board mg-special">
        <h2 class="mg-special__name">{{ 'products.placeholder_title' | t }}</h2>
        <p class="mg-special__text">{{ 'products.placeholder_help' | t }}</p>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "t:names.featured_product",
  "class": "cw-shopify-section",
  "settings": [
    { "type": "product", "id": "product", "label": "t:labels.product" },
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow" },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "t:labels.show_dynamic_checkout", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-3" }
  ],
  "presets": [{ "name": "t:names.featured_product" }]
}
{% endschema %}
