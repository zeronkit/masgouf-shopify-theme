{%- comment -%}
  Shutter down: a full-screen dark board with the awning edge across the top, "Closed until opening day" in chalk script,
  the opening date and bake times as menu lines, and the password as one chalk line at the board's foot.
  A small paper ticket with the newsletter field is pinned at the lower end corner (under the board on phones).
{%- endcomment -%}
<section class="mg-shutter color-{{ section.settings.color_scheme }}">
  <div class="mg-shutter__board">
    <p class="mg-shutter__name">{{ shop.name | escape }}</p>
    <h1 class="mg-shutter__title">
      {%- if shop.password_message != blank -%}{{ shop.password_message | escape }}{%- else -%}{{ 'mg.password.closed' | t }}{%- endif -%}
    </h1>
    {%- if section.blocks.size > 0 -%}
      <dl class="mg-shutter__lines">
        {%- for block in section.blocks -%}
          {%- liquid
            assign mg_bk = 'mg.password.' | append: block.id | replace: '-', '_'
            assign bt_label = mg_bk | append: '_label' | t
            if bt_label contains 'ranslation missing'
              assign bt_label = ''
            endif
            if block.settings.label != blank
              assign bt_label = block.settings.label
            endif
            assign bt_value = mg_bk | append: '_value' | t
            if bt_value contains 'ranslation missing'
              assign bt_value = ''
            endif
            if block.settings.value != blank
              assign bt_value = block.settings.value
            endif
          -%}
          <div class="mg-shutter__line" {{ block.shopify_attributes }}><dt>{{ bt_label | escape }}</dt><dd>{{ bt_value | escape }}</dd></div>
        {%- endfor -%}
      </dl>
    {%- endif -%}
    <div class="mg-shutter__entry">
      {%- form 'storefront_password', class: 'mg-shutter__form' -%}
        {%- if form.errors -%}
          <div class="cw-notice cw-notice--error" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <label class="mg-shutter__label" for="StorePassword">{{ 'password.enter' | t }}</label>
        <div class="mg-shutter__field">
          <input class="cw-input" type="password" id="StorePassword" name="password" autocomplete="current-password" placeholder="{{ 'password.label' | t }}" required{% if form.errors %} aria-invalid="true"{% endif %}>
          <button type="submit" class="cw-button cw-button--primary">{{ 'password.submit' | t }}</button>
        </div>
      {%- endform -%}
      <p class="mg-shutter__small">{{ 'password.owner_html' | t: link: '/admin' }} <span aria-hidden="true">&middot;</span> {{ 'password.powered_by_html' | t: shopify: powered_by_link }}</p>
    </div>
    {%- if section.settings.show_newsletter -%}
      <div class="mg-shutter__ticket">
        <p class="mg-shutter__ticket-title">{{ 'mg.newsletter.heading' | t }}</p>
        <p class="mg-shutter__ticket-text">{{ 'password.newsletter' | t }}</p>
        {% render 'newsletter-form', id: 'PasswordNewsletter' %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:names.password",
  "class": "cw-shopify-section",
  "enabled_on": { "templates": ["password"] },
  "settings": [
    { "type": "checkbox", "id": "show_newsletter", "label": "t:labels.show_newsletter", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "line",
      "name": "t:names.mg_fact",
      "settings": [
        { "type": "text", "id": "label", "label": "t:labels.mg_fact_label" },
        { "type": "text", "id": "value", "label": "t:labels.mg_fact_value" }
      ]
    }
  ]
}
{% endschema %}
