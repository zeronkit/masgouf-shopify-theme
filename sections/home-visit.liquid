{%- comment -%} Masgouf theme by ZeronKit (https://zeronkit.com). Free theme - not for resale or redistribution. © 2026 ZeronKit. {%- endcomment -%}
{%- liquid
  assign t_heading = 'mg.home_visit.heading' | t
  if section.settings.heading != blank
    assign t_heading = section.settings.heading
  endif
  assign t_note = 'mg.home_visit.note_html' | t
  if section.settings.note != blank
    assign t_note = section.settings.note
  endif
  assign t_button_label = 'mg.home_visit.button_label' | t
  if section.settings.button_label != blank
    assign t_button_label = section.settings.button_label
  endif
-%}
{%- comment -%}
  Visit the shop: a photo of the shop front beside a card with the address, opening hours
  (one block per row) and a directions link. The map link opens in the shopper's own map app.
{%- endcomment -%}
{%- liquid
  assign image = section.settings.image
  if image == blank
    for c in collections limit: 10
      if c.featured_image
        assign image = c.featured_image
        break
      endif
    endfor
  endif
  assign address = section.settings.address
  if address == blank and shop.address.street != blank
    assign address = shop.address | format_address
  endif
-%}
{{ 'home.css' | asset_url | stylesheet_tag }}
<section class="cw-section cw-visit color-{{ section.settings.color_scheme }}" aria-labelledby="Visit-{{ section.id }}">
  <div class="cw-wrap cw-visit__grid">
    {%- if section.settings.show_image -%}
      <div class="cw-visit__photo">
        {%- if image != blank -%}
          {% render 'image', image: image, sizes: '(min-width: 990px) 55vw, 100vw' %}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'cw-placeholder' }}
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="cw-visit__card">
      {%- if section.settings.eyebrow != blank -%}<p class="cw-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="cw-h2" id="Visit-{{ section.id }}">{{ t_heading | escape }}</h2>
      {%- if address != blank -%}
        <div class="cw-visit__address">{% render 'icon', name: 'pin' %}<div class="cw-rte">{{ address }}</div></div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <h3 class="cw-visit__label">{{ 'sections.visit.hours' | t }}</h3>
        <dl class="cw-visit__hours">
          {%- for block in section.blocks -%}
{%- liquid
  assign mg_bk = 'mg.home_visit.' | append: block.id | replace: '-', '_'
  assign bt_days = mg_bk | append: '_days' | t
  if bt_days contains 'ranslation missing'
    assign bt_days = ''
  endif
  if block.settings.days != blank
    assign bt_days = block.settings.days
  endif
  assign bt_hours = mg_bk | append: '_hours' | t
  if bt_hours contains 'ranslation missing'
    assign bt_hours = ''
  endif
  if block.settings.hours != blank
    assign bt_hours = block.settings.hours
  endif
-%}
            <div class="cw-visit__row" {{ block.shopify_attributes }}>
              <dt>{{ bt_days | escape }}</dt>
              <dd>{{ bt_hours | escape }}</dd>
            </div>
          {%- endfor -%}
        </dl>
      {%- endif -%}

      {%- if t_note != blank -%}<div class="cw-rte cw-small cw-visit__note">{{ t_note }}</div>{%- endif -%}

      {%- if t_button_label != blank and section.settings.map_link != blank -%}
        <a class="cw-button cw-button--ghost" href="{{ section.settings.map_link }}" target="_blank" rel="noopener">
          {{ t_button_label | escape }}<span class="cw-visually-hidden"> ({{ 'general.new_window' | t }})</span> {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}

      {%- if section.settings.show_signup -%}
        {%- liquid
          assign t_signup = 'mg.newsletter.heading' | t
          if section.settings.signup_heading != blank
            assign t_signup = section.settings.signup_heading
          endif
          assign t_signup_text = 'mg.newsletter.text_html' | t
          if section.settings.signup_text != blank
            assign t_signup_text = section.settings.signup_text
          endif
        -%}
        <div class="mg-stub">
          <h3 class="mg-stub__title" id="Letters-{{ section.id }}">{{ t_signup | escape }}</h3>
          {%- if t_signup_text != blank -%}<div class="cw-rte cw-small mg-stub__text">{{ t_signup_text }}</div>{%- endif -%}
          {%- assign letters_id = 'Letters-form-' | append: section.id -%}
          {% render 'newsletter-form', id: letters_id %}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:names.visit",
  "class": "cw-shopify-section",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    { "type": "richtext", "id": "address", "label": "t:labels.info_address", "info": "t:info.visit_address" },
    { "type": "richtext", "id": "note", "label": "t:labels.note" },
    { "type": "text", "id": "button_label", "label": "t:labels.button_label" },
    { "type": "url", "id": "map_link", "label": "t:labels.map_link", "info": "t:info.map_link" },
    { "type": "checkbox", "id": "show_image", "label": "t:labels.show_image", "default": true },
    { "type": "image_picker", "id": "image", "label": "t:labels.image" },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-3" },
    { "type": "header", "content": "t:labels.mg_signup" },
    { "type": "checkbox", "id": "show_signup", "label": "t:labels.mg_show_signup", "default": true },
    { "type": "text", "id": "signup_heading", "label": "t:labels.heading" },
    { "type": "richtext", "id": "signup_text", "label": "t:labels.text" }
  ],
  "blocks": [
    {
      "type": "hours",
      "name": "t:names.hours_row",
      "settings": [
        { "type": "text", "id": "days", "label": "t:labels.days" },
        { "type": "text", "id": "hours", "label": "t:labels.hours" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:names.visit",
      "blocks": [
        { "type": "hours", "settings": { "days": "Monday to Friday", "hours": "7:00 to 18:00" } },
        { "type": "hours", "settings": { "days": "Saturday", "hours": "8:00 to 17:00" } },
        { "type": "hours", "settings": { "days": "Sunday", "hours": "8:00 to 14:00" } }
      ]
    }
  ]
}
{% endschema %}
