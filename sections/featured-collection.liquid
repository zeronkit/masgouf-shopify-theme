{%- comment -%} Masgouf theme by ZeronKit (https://zeronkit.com). Free theme - not for resale or redistribution. © 2026 ZeronKit. {%- endcomment -%}
{%- liquid
  assign t_heading = 'mg.featured_collection.heading' | t
  if section.settings.heading != blank
    assign t_heading = section.settings.heading
  endif
-%}
{%- liquid
  assign collection = section.settings.collection
  if collection != blank
    assign products = collection.products
  else
    # No collection chosen: show the newest products of the whole store.
    assign collection = collections.all
    assign products = collections.all.products | sort: 'published_at' | reverse
  endif
-%}
{%- if section.settings.layout == 'tray' -%}
  {%- comment -%} The tray: round plates on a static two-row tray, each with a paper price tag and a "+", no arrows. {%- endcomment -%}
  <section class="cw-section mg-tray-section color-{{ section.settings.color_scheme }}">
    <div class="cw-wrap">
      <div class="mg-tray">
        <div class="mg-tray__head">
          {%- if section.settings.eyebrow != blank -%}<p class="cw-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
          <h2 class="cw-h2 mg-tray__title">{{ t_heading | escape }}</h2>
        </div>
        <ul class="mg-tray__plates" role="list">
          {%- if products.size > 0 -%}
            {%- for product in products limit: section.settings.limit -%}
              <li>{% render 'product-card', product: product, style: 'plate' %}</li>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..6) -%}
              <li>{% render 'product-card', product: blank, placeholder_index: i %}</li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
        {%- if section.settings.show_view_all -%}
          <a class="mg-tray__end" href="{{ collection.url }}">{{ 'mg.tray.everything' | t }}<span class="cw-visually-hidden">: {{ collection.title | escape }}</span> {% render 'icon', name: 'arrow' %}</a>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- else -%}
{%- assign is_rail = false -%}
{%- if section.settings.layout == 'rail' -%}{%- assign is_rail = true -%}{%- endif -%}
<section class="cw-section color-{{ section.settings.color_scheme }}">
  <cw-slider class="cw-wrap cw-slider">
    <div class="cw-section__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="cw-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="cw-h2">{{ t_heading | escape }}</h2>
      </div>
      <div class="cw-section__actions">
        {%- if is_rail and section.settings.show_arrows -%}
          {% render 'slider-controls', label: t_heading %}
        {%- endif -%}
        {%- if collection != blank and section.settings.show_view_all -%}
          <a class="cw-button cw-button--text" href="{{ collection.url }}">
            {{ 'collections.view_all' | t }}<span class="cw-visually-hidden">: {{ collection.title | escape }}</span> {% render 'icon', name: 'arrow' %}
          </a>
        {%- endif -%}
      </div>
    </div>
    <ul class="cw-grid cw-grid--{{ section.settings.columns }} cw-grid--m2{% if is_rail %} cw-grid--rail{% endif %}" role="list"{% if is_rail %} data-cw-slider-track{% endif %}>
      {%- if products.size > 0 -%}
        {%- for product in products limit: section.settings.limit -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <li>{% render 'product-card', product: blank, placeholder_index: i %}</li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
    {%- if is_rail -%}
      <span class="cw-slider__progress" data-cw-slider-progress hidden aria-hidden="true"><span></span></span>
    {%- endif -%}
  </cw-slider>
</section>
{%- endif -%}

{% schema %}
{
  "name": "t:names.featured_collection",
  "class": "cw-shopify-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:labels.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:labels.heading" },
    { "type": "collection", "id": "collection", "label": "t:labels.collection" },
    { "type": "range", "id": "limit", "label": "t:labels.products_to_show", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "range", "id": "columns", "label": "t:labels.columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "layout",
      "label": "t:labels.layout",
      "options": [
        { "value": "grid", "label": "t:options.grid" },
        { "value": "rail", "label": "t:options.scroll_rail" },
        { "value": "tray", "label": "t:options.mg_tray" }
      ],
      "default": "grid"
    },
    { "type": "checkbox", "id": "show_arrows", "label": "t:labels.show_arrows_rail", "default": true, "info": "t:info.show_arrows_rail" },
    { "type": "checkbox", "id": "show_view_all", "label": "t:labels.show_view_all", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "t:labels.color_scheme", "default": "scheme-1" }
  ],
  "presets": [{ "name": "t:names.featured_collection" }]
}
{% endschema %}
