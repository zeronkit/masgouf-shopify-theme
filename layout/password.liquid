{%- comment -%} Masgouf theme by ZeronKit (https://zeronkit.com). Free theme - not for resale or redistribution. © 2026 ZeronKit. {%- endcomment -%}
{%- liquid
  assign lang = request.locale.iso_code | split: '-' | first
  assign dir = 'ltr'
  assign rtl_languages = 'ar,he,fa,ur,ps,yi' | split: ','
  if rtl_languages contains lang
    assign dir = 'rtl'
  endif
-%}
<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}" dir="{{ dir }}" data-zk="ZK-MASGOUF-AA054DDEB651">
  <head>
    <meta charset="utf-8">
    <!-- Masgouf by ZeronKit (https://zeronkit.com). Signature ZK-MASGOUF-AA054DDEB651 -->
    <meta name="generator" content="Masgouf by ZeronKit">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    <title>{{ shop.name }}</title>
    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}
    {% render 'meta-tags' %}
    {% render 'theme-styles' %}
    {%- render 'mg-arabic-font' -%}
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    {{ 'masgouf.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" type="module"></script>
    {{ content_for_header }}
    <script>document.documentElement.classList.replace('no-js', 'js');</script>
  </head>
  <body class="cw-body color-{{ settings.body_scheme }} cw-bg-{{ settings.background_style }} cw-buttons-{{ settings.button_style }} cw-space-{{ settings.spacing }} cw-type-{{ settings.type_scale }}">
    <a class="cw-skip" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    <main id="MainContent" class="cw-main" tabindex="-1">
      {{ content_for_layout }}
    </main>
  </body>
</html>
