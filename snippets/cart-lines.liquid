{%- comment -%}
  Cart line items shared by the cart page and the cart drawer.
  Params: section_id, style ('plates': round photos in a two column list; 'ticket': text lines "1 × name ..... price" with the size and a small stepper under), photos (ticket only: small round plates)
{%- endcomment -%}
{%- if style == 'plates' -%}
<ul class="mg-platelist" role="list">
  {%- for item in cart.items -%}
    <li class="cw-line mg-plateline" data-line="{{ forloop.index }}">
      <a href="{{ item.url }}" class="mg-plateline__plate" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}{% render 'image', image: item.image, sizes: '120px', max: 240, alt: '' %}{%- endif -%}
      </a>
      <div class="mg-plateline__body">
        <a class="mg-plateline__name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
        {%- unless item.product.has_only_default_variant -%}<p class="mg-plateline__size">{{ item.variant.title | escape }}</p>{%- endunless -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}<p class="mg-plateline__size">{{ property.first | escape }}: {{ property.last | escape }}</p>{%- endif -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}<p class="mg-plateline__size">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{%- endif -%}
        <p class="mg-plateline__price">
          {%- if item.original_line_price != item.final_line_price -%}
            <span class="cw-visually-hidden">{{ 'products.price.regular' | t }}</span><s>{{ item.original_line_price | money }}</s>
            <span class="cw-visually-hidden">{{ 'products.price.sale' | t }}</span>
          {%- endif -%}
          {{ item.final_line_price | money }}
          {%- if item.quantity > 1 -%}{%- assign each_price = item.final_price | money -%} <span class="mg-plateline__each">{{ 'cart.each' | t: price: each_price }}</span>{%- endif -%}
        </p>
        {%- if item.line_level_discount_allocations.size > 0 -%}
          <ul class="mg-tkline__discounts" role="list">
            {%- for discount in item.line_level_discount_allocations -%}
              <li class="cw-discount">{{ discount.discount_application.title | escape }} (-{{ discount.amount | money }})</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <div class="mg-plateline__controls">
          {%- liquid
            assign qty_label = 'cart.quantity_for' | t: title: item.product.title
            assign qty_id = 'Quantity-' | append: section_id | append: '-' | append: forloop.index
          -%}
          {% render 'quantity', id: qty_id, name: 'updates[]', value: item.quantity, min: 0, line: forloop.index, label: qty_label %}
          <button type="button" class="cw-link-button mg-tkline__remove" data-cw-remove="{{ forloop.index }}">
            {{ 'cart.remove' | t }}<span class="cw-visually-hidden"> {{ item.product.title | escape }}</span>
          </button>
        </div>
        <p class="cw-line__error cw-small" role="alert" hidden data-cw-line-error></p>
      </div>
    </li>
  {%- endfor -%}
</ul>
{%- elsif style == 'ticket' -%}
<ul class="mg-tklines" role="list">
  {%- for item in cart.items -%}
    <li class="cw-line mg-tkline{% if photos %} mg-tkline--plate{% endif %}" data-line="{{ forloop.index }}">
      {%- if photos and item.image -%}
        <span class="mg-tkline__plate">{{ item.image | image_url: width: 80, height: 80, crop: 'center' | image_tag: alt: '', width: 40, height: 40, loading: 'lazy' }}</span>
      {%- endif -%}
      <p class="mg-tkline__main">
        <span class="mg-tkline__qty" aria-hidden="true">{{ item.quantity }}&nbsp;&times;</span>
        <a class="mg-tkline__name" href="{{ item.url }}">{{ item.product.title | escape }}</a>
        <span class="mg-tkline__price">
          {%- if item.original_line_price != item.final_line_price -%}
            <span class="cw-visually-hidden">{{ 'products.price.regular' | t }}</span><s>{{ item.original_line_price | money }}</s>
            <span class="cw-visually-hidden">{{ 'products.price.sale' | t }}</span>
          {%- endif -%}
          {{ item.final_line_price | money }}
        </span>
      </p>
      <div class="mg-tkline__sub">
        {%- unless item.product.has_only_default_variant -%}<span class="mg-tkline__variant">{{ item.variant.title | escape }}</span>{%- endunless -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}<span class="mg-tkline__variant">{{ property.first | escape }}: {{ property.last | escape }}</span>{%- endif -%}
        {%- endfor -%}
        {%- if item.selling_plan_allocation -%}<span class="mg-tkline__variant">{{ item.selling_plan_allocation.selling_plan.name | escape }}</span>{%- endif -%}
        {%- liquid
          assign qty_label = 'cart.quantity_for' | t: title: item.product.title
          assign qty_id = 'Quantity-' | append: section_id | append: '-' | append: forloop.index
        -%}
        {% render 'quantity', id: qty_id, name: 'updates[]', value: item.quantity, min: 0, line: forloop.index, label: qty_label %}
        <button type="button" class="cw-link-button mg-tkline__remove" data-cw-remove="{{ forloop.index }}">
          {{ 'cart.remove' | t }}<span class="cw-visually-hidden"> {{ item.product.title | escape }}</span>
        </button>
      </div>
      {%- if item.line_level_discount_allocations.size > 0 -%}
        <ul class="mg-tkline__discounts" role="list">
          {%- for discount in item.line_level_discount_allocations -%}
            <li class="cw-discount">{{ discount.discount_application.title | escape }} (-{{ discount.amount | money }})</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
      <p class="cw-line__error cw-small" role="alert" hidden data-cw-line-error></p>
    </li>
  {%- endfor -%}
</ul>
{%- else -%}
<ul class="cw-lines" role="list">
  {%- for item in cart.items -%}
    <li class="cw-line" data-line="{{ forloop.index }}">
      <a href="{{ item.url }}" class="cw-line__media" tabindex="-1" aria-hidden="true">
        {%- if item.image -%}
          {% render 'image', image: item.image, sizes: '120px', max: 240, alt: '' %}
        {%- endif -%}
      </a>

      <div class="cw-line__info">
        <a class="cw-line__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>

        {%- if item.product.has_only_default_variant == false or item.properties.size > 0 -%}
          <dl class="cw-line__meta">
            {%- unless item.product.has_only_default_variant -%}
              {%- for option in item.options_with_values -%}
                <div><dt>{{ option.name | escape }}:</dt> <dd>{{ option.value | escape }}</dd></div>
              {%- endfor -%}
            {%- endunless -%}
            {%- for property in item.properties -%}
              {%- assign first_char = property.first | slice: 0 -%}
              {%- if property.last != blank and first_char != '_' -%}
                <div>
                  <dt>{{ property.first | escape }}:</dt>
                  <dd>
                    {%- if property.last contains '/uploads/' -%}
                      <a href="{{ property.last }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last }}</a>
                    {%- else -%}
                      {{ property.last | escape }}
                    {%- endif -%}
                  </dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </dl>
        {%- endif -%}

        {%- if item.selling_plan_allocation -%}
          <p class="cw-line__plan cw-small">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>
        {%- endif -%}

        {%- comment -%} The line total sits at the end of the row; the price of one is added only when more than one is in the basket. {%- endcomment -%}
        {%- if item.quantity > 1 or item.unit_price_measurement -%}
          <p class="cw-line__price cw-small cw-muted">
            {%- if item.quantity > 1 -%}
              {%- assign each_price = item.final_price | money -%}
              <span>{{ 'cart.each' | t: price: each_price }}</span>
            {%- endif -%}
            {%- if item.unit_price_measurement -%}
              <span class="cw-price__unit">
                {{ item.unit_price | money }}/
                {%- if item.unit_price_measurement.reference_value != 1 -%}{{ item.unit_price_measurement.reference_value }}{%- endif -%}
                {{ item.unit_price_measurement.reference_unit }}
              </span>
            {%- endif -%}
          </p>
        {%- endif -%}

        {%- if item.line_level_discount_allocations.size > 0 -%}
          <ul class="cw-line__discounts" role="list">
            {%- for discount in item.line_level_discount_allocations -%}
              <li class="cw-discount">{{ discount.discount_application.title | escape }} (-{{ discount.amount | money }})</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="cw-line__controls">
          {%- liquid
            assign qty_label = 'cart.quantity_for' | t: title: item.product.title
            assign qty_id = 'Quantity-' | append: section_id | append: '-' | append: forloop.index
          -%}
          {% render 'quantity',
            id: qty_id,
            name: 'updates[]',
            value: item.quantity,
            min: 0,
            line: forloop.index,
            label: qty_label
          %}
          <button type="button" class="cw-link-button" data-cw-remove="{{ forloop.index }}">
            {{ 'cart.remove' | t }}<span class="cw-visually-hidden"> {{ item.product.title | escape }}</span>
          </button>
        </div>
        <p class="cw-line__error cw-small" role="alert" hidden data-cw-line-error></p>
      </div>

      <div class="cw-line__total">
        {%- if item.original_line_price != item.final_line_price -%}
          <span class="cw-visually-hidden">{{ 'products.price.regular' | t }}</span>
          <s class="cw-muted cw-small">{{ item.original_line_price | money }}</s>
          <span class="cw-visually-hidden">{{ 'products.price.sale' | t }}</span>
        {%- endif -%}
        <span>{{ item.final_line_price | money }}</span>
      </div>
    </li>
  {%- endfor -%}
</ul>
{%- endif -%}
